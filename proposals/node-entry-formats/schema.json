{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": [
    "object",
    "null"
  ],
  "required": [
    "package",
    "version",
    "source",
    "formats"
  ],
  "additionalProperties": false,
  "properties": {
    "package": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "minLength": 1,
      "pattern": "^\\d+\\.\\d+\\.\\d+(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$"
    },
    "source": {
      "type": "string",
      "pattern": "^https://registry\\.npmjs\\.org/"
    },
    "formats": {
      "type": "array",
      "minItems": 1,
      "maxItems": 2,
      "uniqueItems": true,
      "items": {
        "enum": [
          "ESM",
          "CommonJS"
        ]
      }
    }
  }
}
